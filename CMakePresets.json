{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "asan",
      "displayName": "Debug with AddressSanitizer and UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "tsan",
      "displayName": "Debug with ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "host-tools",
      "displayName": "macOS host tools for cross builds (quench_shaderc only)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "QUENCH_BUILD_TESTS": "OFF" }
    },
    {
      "name": "wasm-node",
      "displayName": "WebAssembly, headless tests under Node.js, no threads (configure with emcmake; build host-tools first)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "environment": { "EMSDK_PYTHON": "/opt/homebrew/bin/python3" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXE_LINKER_FLAGS": "-sALLOW_MEMORY_GROWTH=1 -sNODERAWFS=1 -sEXIT_RUNTIME=1 -sSTACK_OVERFLOW_CHECK=2 -sASSERTIONS=1",
        "QUENCH_HOST_SHADERC": "${sourceDir}/build/host-tools/quench_shaderc"
      }
    },
    {
      "name": "ios-base",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "26.0",
        "QUENCH_BUILD_TESTS": "OFF",
        "QUENCH_HOST_SHADERC": "${sourceDir}/build/host-tools/quench_shaderc"
      }
    },
    {
      "name": "ios-sim-release",
      "displayName": "iOS Simulator Release (arm64, iOS 26+, run build/host-tools first)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_SYSROOT": "iphonesimulator" }
    },
    {
      "name": "ios-device-release",
      "displayName": "iOS device Release (arm64, iOS 26+, run build/host-tools first)",
      "inherits": "ios-base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "CMAKE_OSX_SYSROOT": "iphoneos" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "host-tools", "configurePreset": "host-tools", "targets": ["quench_shaderc"] },
    { "name": "wasm-node", "configurePreset": "wasm-node" },
    { "name": "ios-sim-release", "configurePreset": "ios-sim-release" },
    { "name": "ios-device-release", "configurePreset": "ios-device-release" }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } },
    { "name": "tsan", "configurePreset": "tsan", "output": { "outputOnFailure": true } },
    { "name": "wasm-node", "configurePreset": "wasm-node", "output": { "outputOnFailure": true } }
  ]
}
