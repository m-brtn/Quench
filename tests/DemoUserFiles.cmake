# Demo checks with files in the user directory (cmake -P): the check mode's checks.json, settings.json and its
# fallback for a corrupt file, and benchmark.json. Every step runs the demo on a fresh USER_DIR (--user-dir), fails on
# an exit code other than 0 or a failed scenario line, and reads the file the demo wrote with string(JSON).
#
#   cmake -DAPP=<quench-demo> -DSCENARIOS=<dir> -DUSER_DIR=<dir> -DKIND=checks|settings|benchmark
#         [-DENVIRONMENT=<NAME=value|...>] -P DemoUserFiles.cmake

string(REPLACE "|" ";" environment "${ENVIRONMENT}")

function(run_demo)
    execute_process(COMMAND ${CMAKE_COMMAND} -E env ${environment} ${APP} --window 960x540 --user-dir ${USER_DIR}
                            ${ARGN}
                    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE out)
    message("${out}")
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "the demo exited with ${result}: ${ARGN}")
    endif()
    if(out MATCHES "FAIL line")
        message(FATAL_ERROR "a scenario line failed: ${ARGN}")
    endif()
endfunction()

function(read_json file out)
    if(NOT EXISTS ${USER_DIR}/${file})
        message(FATAL_ERROR "the demo wrote no ${USER_DIR}/${file}")
    endif()
    file(READ ${USER_DIR}/${file} text)
    string(JSON type ERROR_VARIABLE error TYPE "${text}")
    if(error OR NOT type STREQUAL "OBJECT")
        message(FATAL_ERROR "${file} is not a JSON object: ${error}\n${text}")
    endif()
    set(${out} "${text}" PARENT_SCOPE)
endfunction()

# expect_json(<json> <expected> <member or index>...)
function(expect_json json expected)
    string(JSON value ERROR_VARIABLE error GET "${json}" ${ARGN})
    if(error OR NOT value STREQUAL "${expected}")
        message(FATAL_ERROR "JSON ${ARGN}: '${value}', expected '${expected}' ${error}")
    endif()
endfunction()

file(REMOVE_RECURSE ${USER_DIR})
file(MAKE_DIRECTORY ${USER_DIR})

if(KIND STREQUAL "checks")
    run_demo(--checks --script ${SCENARIOS}/checks.txt)
    read_json(checks.json json)
    expect_json("${json}" 1 version)
    expect_json("${json}" "Quench Demo" app)
    string(JSON items LENGTH "${json}" items)
    if(NOT items EQUAL 39)
        message(FATAL_ERROR "checks.json: ${items} items, expected 39")
    endif()
    expect_json("${json}" materials.fence_holes items 0 id)
    expect_json("${json}" ok items 0 status)
    expect_json("${json}" problem items 1 status)
    expect_json("${json}" "The tint looks grey" items 1 note)
    expect_json("${json}" skipped items 2 status)
    expect_json("${json}" ok items 3 status)
    expect_json("${json}" pending items 4 status)
    expect_json("${json}" 2 summary ok)
    expect_json("${json}" 1 summary problem)
    expect_json("${json}" 1 summary skipped)
    expect_json("${json}" 35 summary pending)
    string(JSON backend GET "${json}" items 0 backend)
    string(JSON time GET "${json}" items 0 time)
    if(backend STREQUAL "" OR NOT time MATCHES "^20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]T.*Z$")
        message(FATAL_ERROR "checks.json: item 0 has backend '${backend}', time '${time}'")
    endif()
    # Again on the same directory: the marks are read back; then a file that is not JSON starts empty.
    run_demo(--checks --script ${SCENARIOS}/checks_resume.txt)
    file(WRITE ${USER_DIR}/checks.json "{ not json")
    run_demo(--checks --script ${SCENARIOS}/checks_corrupt.txt)
elseif(KIND STREQUAL "settings")
    run_demo(--settings-file settings.json --script ${SCENARIOS}/settings_save.txt)
    read_json(settings.json json)
    expect_json("${json}" 1 version)
    expect_json("${json}" shadows section)
    expect_json("${json}" 1.25 ui_scale)
    expect_json("${json}" OFF show_ui)
    expect_json("${json}" on touch_controls)
    run_demo(--settings-file settings.json --script ${SCENARIOS}/settings_load.txt)
    file(WRITE ${USER_DIR}/settings.json "{ not json")
    run_demo(--settings-file settings.json --script ${SCENARIOS}/settings_corrupt.txt)
    read_json(settings.json json)
    expect_json("${json}" sky section)
    expect_json("${json}" 1 ui_scale)
    run_demo(--settings-file settings.json --no-settings --script ${SCENARIOS}/settings_ignored.txt)
    read_json(settings.json json)
    expect_json("${json}" sky section)
elseif(KIND STREQUAL "benchmark")
    run_demo(--script ${SCENARIOS}/benchmark_all.txt)
    read_json(benchmark.json json)
    expect_json("${json}" 1 version)
    string(JSON sections LENGTH "${json}" sections)
    if(NOT sections EQUAL 12)
        message(FATAL_ERROR "benchmark.json: ${sections} sections, expected 12")
    endif()
    expect_json("${json}" materials sections 0 section)
    expect_json("${json}" raytracing sections 10 section)
    expect_json("${json}" tunnel sections 11 section)
    foreach(i RANGE 11)
        string(JSON frames GET "${json}" sections ${i} frames)
        string(JSON cpu GET "${json}" sections ${i} cpu_p50_ms)
        if(frames LESS 1 OR cpu LESS_EQUAL 0)
            message(FATAL_ERROR "benchmark.json: section ${i}: ${frames} frames, CPU median ${cpu} ms")
        endif()
    endforeach()
else()
    message(FATAL_ERROR "KIND: checks, settings or benchmark")
endif()
