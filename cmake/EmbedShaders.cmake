# `cmake -P` script of quench_add_shaders(): embeds the compiled blobs of one shader set into a C++ source that
# defines quench::shaders::<NAME>. Parameters: NAME, SOURCE_NAME, ENTRIES and FORMATS (comma-separated), GEN_DIR,
# OUTPUT. Formats: spirv (<entry>.spv), msl (<entry>.msl), metallib (<entry>.metallib), dxil (<entry>.dxil). The stage,
# resource counts and thread group size of each entry come from <entry>.reflect.
cmake_minimum_required(VERSION 3.28)
foreach(param NAME SOURCE_NAME ENTRIES FORMATS GEN_DIR OUTPUT)
    if(NOT DEFINED ${param})
        message(FATAL_ERROR "EmbedShaders.cmake: NAME, SOURCE_NAME, ENTRIES, FORMATS, GEN_DIR, OUTPUT are required")
    endif()
endforeach()
string(REPLACE "," ";" ENTRIES "${ENTRIES}")
string(REPLACE "," ";" FORMATS "${FORMATS}")
set(_ext_spirv spv)
set(_ext_msl msl)
set(_ext_metallib metallib)
set(_ext_dxil dxil)

set(_arrays "")
set(_rows "")
foreach(entry IN LISTS ENTRIES)
    # <entry>.reflect (written by quench_shaderc): "key=value" lines.
    file(STRINGS "${GEN_DIR}/${entry}.reflect" _lines)
    foreach(_line IN LISTS _lines)
        if(_line MATCHES "^([a-z_]+)=([a-z0-9]+)$")
            set(_r_${CMAKE_MATCH_1} ${CMAKE_MATCH_2})
        endif()
    endforeach()
    set(_keys stage samplers storage_textures storage_buffers uniform_buffers readwrite_storage_textures
              readwrite_storage_buffers threads_x threads_y threads_z)
    foreach(_key IN LISTS _keys)
        if(NOT DEFINED _r_${_key})
            message(FATAL_ERROR "EmbedShaders.cmake: '${_key}' missing in ${GEN_DIR}/${entry}.reflect")
        endif()
    endforeach()
    if(_r_stage STREQUAL "vertex")
        set(_stage Vertex)
    elseif(_r_stage STREQUAL "fragment")
        set(_stage Fragment)
    else()
        set(_stage Compute)
    endif()
    if(NOT DEFINED _r_acceleration_structures)
        set(_r_acceleration_structures 0)
    endif()
    set(_row "    {\"${entry}\", quench::ShaderStage::${_stage}, {${_r_samplers}, ${_r_storage_textures}, ")
    string(APPEND _row "${_r_storage_buffers}, ${_r_uniform_buffers}, ${_r_readwrite_storage_textures}, ")
    string(APPEND _row "${_r_readwrite_storage_buffers}, {${_r_threads_x}, ${_r_threads_y}, ${_r_threads_z}}, ")
    string(APPEND _row "${_r_acceleration_structures}}")
    foreach(_key IN LISTS _keys ITEMS acceleration_structures)
        unset(_r_${_key})
    endforeach()
    foreach(fmt spirv msl metallib dxil)
        if(fmt IN_LIST FORMATS)
            set(_file ${GEN_DIR}/${entry}.${_ext_${fmt}})
            file(READ "${_file}" _hex HEX)
            file(SIZE "${_file}" _size)
            string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
            string(REGEX REPLACE "((0x..,){32})" "\\1\n" _bytes "${_bytes}")
            # A trailing zero keeps text formats (MSL) NUL-terminated; it is not counted in the size.
            string(APPEND _arrays "const std::uint8_t k_${entry}_${fmt}[] = {\n${_bytes}0x00};\n")
            string(APPEND _row ", {k_${entry}_${fmt}, ${_size}}")
        else()
            string(APPEND _row ", {nullptr, 0}")
        endif()
    endforeach()
    string(APPEND _rows "${_row}},\n")
endforeach()
list(LENGTH ENTRIES _count)

if(_count EQUAL 0)
    # Every entry was left out (ray query entries without DXC): an empty table.
    file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedShaders.cmake from ${SOURCE_NAME}. Do not edit.
#include \"${NAME}_shaders.h\"

namespace quench::shaders {
const ShaderTable ${NAME} = {nullptr, 0};
} // namespace quench::shaders
")
    return()
endif()

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedShaders.cmake from ${SOURCE_NAME}. Do not edit.
#include \"${NAME}_shaders.h\"

#include <cstdint>

namespace {
${_arrays}
const quench::ShaderBlob kBlobs[] = {
${_rows}};
} // namespace

namespace quench::shaders {
const ShaderTable ${NAME} = {kBlobs, ${_count}};
} // namespace quench::shaders
")
